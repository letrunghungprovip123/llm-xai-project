{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/server/llmNarrative/**/*.ts",
    "src/app/api/experiments/llm-narrative/route.ts",
    "batch/llm-narrative/**/*.ts",
    "tests/llmNarrative/**/*.ts"
  ]
}
