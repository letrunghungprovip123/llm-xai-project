{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims.schema.json",
  "title": "Finalized atomic validation claim V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_schema_version", "claim_id", "parent_claim_id", "generation_id",
    "model_id", "source_ir_id", "case_id", "evidence_level", "repeat_id",
    "local_claim_index", "source_section", "source_factor_id", "source_text",
    "source_start", "source_end", "source_span_start", "source_span_end",
    "source_input_sha256", "source_text_sha256", "claim_type",
    "claim_subtype", "proposition_status", "subject_type", "feature_id",
    "concept_id", "direction", "magnitude", "certainty", "causal_strength",
    "numeric_value", "numeric_unit", "numeric_role", "claim_origin",
    "model_normalized_claim_key", "semantic_signature",
    "normalized_claim_key", "extractor_provider", "extractor_model_id",
    "extractor_version", "extractor_prompt_version", "extractor_prompt_sha256",
    "extractor_status", "finalizer_version", "finalization_policy_version"
  ],
  "properties": {
    "claim_schema_version": {"const": "claims_v3"},
    "claim_id": {"type": "string", "pattern": "^claim_[a-f0-9]{32}$"},
    "parent_claim_id": {
      "oneOf": [
        {"type": "string", "pattern": "^claim_[a-f0-9]{32}$"},
        {"type": "null"}
      ]
    },
    "generation_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "source_ir_id": {"type": "string", "minLength": 1},
    "case_id": {"type": ["string", "null"]},
    "evidence_level": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5"]},
    "repeat_id": {"type": "integer", "minimum": 1},
    "local_claim_index": {"type": "integer", "minimum": 1},
    "source_section": {
      "enum": [
        "prediction_summary", "factor_name", "factor_explanation",
        "uncertainty_note", "distributed_evidence_note", "safe_summary"
      ]
    },
    "source_factor_id": {"type": ["string", "null"]},
    "source_text": {"type": "string", "minLength": 1},
    "source_start": {"type": "integer", "minimum": 0},
    "source_end": {"type": "integer", "minimum": 1},
    "source_span_start": {"type": "integer", "minimum": 0},
    "source_span_end": {"type": "integer", "minimum": 1},
    "source_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claim_type": {
      "enum": [
        "prediction", "feature_presence", "feature_direction",
        "concept_presence", "concept_direction", "magnitude", "ranking",
        "numeric", "causal", "uncertainty", "distributed_evidence",
        "recommendation", "limitation"
      ]
    },
    "claim_subtype": {
      "enum": [
        "OVERALL_LABEL", "OVERALL_PROBABILITY", "THRESHOLD_COMPARISON",
        "OVERALL_PREDICTION_SUMMARY", "UNRESOLVED_PREDICTION", "FEATURE_MENTION",
        "FEATURE_RISK_DIRECTION", "CONCEPT_MENTION", "CONCEPT_RISK_DIRECTION",
        "FEATURE_STRENGTH", "CONCEPT_STRENGTH", "COMPARATIVE_STRENGTH",
        "OVERALL_BALANCE", "UNRESOLVED_MAGNITUDE", "FEATURE_RANK", "CONCEPT_RANK", "PREDICTION_SCORE",
        "DECISION_THRESHOLD", "FEATURE_VALUE", "CONCEPT_VALUE", "RANK_VALUE", "EVIDENCE_COUNT",
        "OTHER_NUMERIC", "CAUSAL_ATTRIBUTION", "PROBABILITY_HEDGE",
        "MODEL_PREDICTION_NOT_OUTCOME", "NO_GUARANTEE",
        "EVIDENCE_SCOPE_UNCERTAINTY", "CONFIDENCE_STRENGTH", "UNRESOLVED_UNCERTAINTY",
        "MULTIPLE_FEATURES", "MULTIPLE_CONCEPTS", "MIXED_DIRECTIONS",
        "DISTRIBUTED_SHAP_MASS", "CROSS_SECTION_SYNTHESIS", "UNRESOLVED_DISTRIBUTED_EVIDENCE", "HUMAN_REVIEW",
        "REQUEST_MORE_INFORMATION", "CAUTION_IN_DECISION_USE",
        "PRESCRIPTIVE_FINANCIAL_ACTION", "UNRESOLVED_RECOMMENDATION", "NON_CAUSAL",
        "NOT_FINANCIAL_ADVICE", "NOT_SOLE_DECISION_BASIS",
        "INCOMPLETE_EVIDENCE", "MODEL_NOT_CERTAIN", "UNRESOLVED_LIMITATION"
      ]
    },
    "proposition_status": {"enum": ["COMPLETE", "INCOMPLETE_FRAGMENT"]},
    "subject_type": {
      "enum": ["prediction", "feature", "concept", "evidence", "narrative", "none"]
    },
    "feature_id": {"type": ["string", "null"]},
    "concept_id": {"type": ["string", "null"]},
    "direction": {
      "enum": ["increase_risk", "decrease_risk", "mixed", "neutral", "unknown"]
    },
    "magnitude": {"enum": ["weak", "moderate", "strong", "unknown", null]},
    "certainty": {
      "enum": ["deterministic", "probabilistic", "hedged", "unknown"]
    },
    "causal_strength": {
      "enum": ["associational", "causal", "none", "unknown"]
    },
    "numeric_value": {"type": ["number", "null"]},
    "numeric_unit": {"type": ["string", "null"]},
    "numeric_role": {
      "enum": [
        "prediction_score", "decision_threshold", "feature_value", "rank",
        "other", null
      ]
    },
    "claim_origin": {
      "enum": ["llm", "deterministic_metadata", "derived_numeric"]
    },
    "model_normalized_claim_key": {"type": ["string", "null"]},
    "semantic_signature": {"type": "string", "minLength": 1},
    "normalized_claim_key": {"type": "string", "minLength": 1},
    "extractor_provider": {"const": "deepseek"},
    "extractor_model_id": {"type": "string", "minLength": 1},
    "extractor_version": {"type": "string", "minLength": 1},
    "extractor_prompt_version": {"type": "string", "minLength": 1},
    "extractor_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extractor_status": {"const": "SUCCESS"},
    "finalizer_version": {"type": "string", "minLength": 1},
    "finalization_policy_version": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"claim_type": {"const": "prediction"}}},
      "then": {
        "properties": {
          "claim_subtype": {
            "enum": [
              "OVERALL_LABEL", "OVERALL_PROBABILITY", "THRESHOLD_COMPARISON",
              "OVERALL_PREDICTION_SUMMARY", "UNRESOLVED_PREDICTION"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "feature_presence"}}},
      "then": {"properties": {"claim_subtype": {"const": "FEATURE_MENTION"}}}
    },
    {
      "if": {"properties": {"claim_type": {"const": "feature_direction"}}},
      "then": {
        "properties": {"claim_subtype": {"const": "FEATURE_RISK_DIRECTION"}}
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "concept_presence"}}},
      "then": {"properties": {"claim_subtype": {"const": "CONCEPT_MENTION"}}}
    },
    {
      "if": {"properties": {"claim_type": {"const": "concept_direction"}}},
      "then": {
        "properties": {"claim_subtype": {"const": "CONCEPT_RISK_DIRECTION"}}
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "magnitude"}}},
      "then": {
        "properties": {
          "claim_subtype": {
            "enum": [
              "FEATURE_STRENGTH", "CONCEPT_STRENGTH",
              "COMPARATIVE_STRENGTH", "OVERALL_BALANCE", "UNRESOLVED_MAGNITUDE"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "ranking"}}},
      "then": {
        "properties": {
          "claim_subtype": {"enum": ["FEATURE_RANK", "CONCEPT_RANK"]}
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "numeric"}}},
      "then": {
        "properties": {
          "claim_subtype": {
            "enum": [
              "PREDICTION_SCORE", "DECISION_THRESHOLD", "FEATURE_VALUE", "CONCEPT_VALUE",
              "RANK_VALUE", "EVIDENCE_COUNT", "OTHER_NUMERIC"
            ]
          },
          "numeric_value": {"type": "number"}
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "causal"}}},
      "then": {"properties": {"claim_subtype": {"const": "CAUSAL_ATTRIBUTION"}}}
    },
    {
      "if": {"properties": {"claim_type": {"const": "uncertainty"}}},
      "then": {
        "properties": {
          "claim_subtype": {
            "enum": [
              "PROBABILITY_HEDGE", "MODEL_PREDICTION_NOT_OUTCOME",
              "NO_GUARANTEE", "EVIDENCE_SCOPE_UNCERTAINTY",
              "CONFIDENCE_STRENGTH", "UNRESOLVED_UNCERTAINTY"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "distributed_evidence"}}},
      "then": {
        "properties": {
          "claim_subtype": {
            "enum": [
              "MULTIPLE_FEATURES", "MULTIPLE_CONCEPTS", "MIXED_DIRECTIONS",
              "DISTRIBUTED_SHAP_MASS", "CROSS_SECTION_SYNTHESIS",
              "UNRESOLVED_DISTRIBUTED_EVIDENCE"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "recommendation"}}},
      "then": {
        "properties": {
          "claim_subtype": {
            "enum": [
              "HUMAN_REVIEW", "REQUEST_MORE_INFORMATION",
              "CAUTION_IN_DECISION_USE", "PRESCRIPTIVE_FINANCIAL_ACTION",
              "UNRESOLVED_RECOMMENDATION"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "limitation"}}},
      "then": {
        "properties": {
          "claim_subtype": {
            "enum": [
              "NON_CAUSAL", "NOT_FINANCIAL_ADVICE",
              "NOT_SOLE_DECISION_BASIS", "INCOMPLETE_EVIDENCE",
              "MODEL_NOT_CERTAIN", "UNRESOLVED_LIMITATION"
            ]
          }
        }
      }
    }
  ]
}
