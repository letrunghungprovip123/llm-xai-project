{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim_extraction_attempt.schema.json",
  "title": "Atomic claim extraction API attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_schema_version", "attempt_id", "generation_id", "canonical_key",
    "source_ir_id", "case_id", "evidence_level", "repeat_id", "attempt_number",
    "started_at", "completed_at", "duration_ms", "status", "failure_code",
    "failure_message", "result_claim_count", "source_input_sha256",
    "extractor_provider", "extractor_model_id", "extractor_version",
    "extractor_prompt_version", "response_received", "raw_response_sha256",
    "raw_response_text", "stop_reason", "usage"
  ],
  "properties": {
    "attempt_schema_version": {"enum": ["claim_extraction_attempt_v1", "claim_extraction_attempt_v2"]},
    "attempt_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "canonical_key": {"type": "string", "minLength": 1},
    "source_ir_id": {"type": "string", "minLength": 1},
    "case_id": {"type": ["string", "null"]},
    "evidence_level": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5"]},
    "repeat_id": {"type": "integer", "minimum": 1},
    "attempt_number": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "status": {"enum": ["SUCCESS", "VALIDATION_FAILED", "BEDROCK_FAILED", "PROVIDER_FAILED"]},
    "failure_code": {
      "enum": [
        "GENERATION_UNUSABLE", "SOURCE_TEXT_EMPTY", "BEDROCK_CALL_FAILED", "PROVIDER_CALL_FAILED",
        "RESPONSE_NOT_JSON", "RESPONSE_SCHEMA_INVALID", "SOURCE_SPAN_INVALID",
        "NO_CLAIMS_EXTRACTED", null
      ]
    },
    "failure_message": {"type": ["string", "null"]},
    "result_claim_count": {"type": "integer", "minimum": 0},
    "source_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extractor_provider": {"enum": ["amazon_bedrock", "deepseek"]},
    "extractor_model_id": {"type": "string", "minLength": 1},
    "extractor_version": {"type": "string", "minLength": 1},
    "extractor_prompt_version": {"type": "string", "minLength": 1},
    "extractor_prompt_sha256": {
      "type": "string", "pattern": "^[a-f0-9]{64}$"
    },
    "response_received": {"type": "boolean"},
    "raw_response_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_response_text": {"type": ["string", "null"]},
    "stop_reason": {"type": ["string", "null"]},
    "provider_request_id": {"type": ["string", "null"]},
    "provider_returned_model_id": {"type": ["string", "null"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "number", "minimum": 0},
        "output_tokens": {"type": "number", "minimum": 0},
        "total_tokens": {"type": "number", "minimum": 0}
      }
    },
    "postprocess_metrics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "llm_claim_count", "deterministic_claim_count_added",
        "derived_numeric_claim_count_added", "causal_overclaim_count_demoted",
        "semantic_duplicate_count_removed",
        "final_claim_count", "nonempty_source_slot_count",
        "claimed_source_slot_count", "semantically_redundant_source_slots",
        "unclaimed_source_slots", "effective_source_coverage_rate"
      ],
      "properties": {
        "llm_claim_count": {"type": "integer", "minimum": 0},
        "deterministic_claim_count_added": {"type": "integer", "minimum": 0},
        "derived_numeric_claim_count_added": {"type": "integer", "minimum": 0},
        "causal_overclaim_count_demoted": {"type": "integer", "minimum": 0},
        "semantic_duplicate_count_removed": {"type": "integer", "minimum": 0},
        "final_claim_count": {"type": "integer", "minimum": 0},
        "nonempty_source_slot_count": {"type": "integer", "minimum": 0},
        "claimed_source_slot_count": {"type": "integer", "minimum": 0},
        "semantically_redundant_source_slots": {
          "type": "array", "items": {"type": "string"}, "uniqueItems": true
        },
        "unclaimed_source_slots": {
          "type": "array", "items": {"type": "string"}, "uniqueItems": true
        },
        "effective_source_coverage_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"attempt_schema_version": {"const": "claim_extraction_attempt_v2"}}
      },
      "then": {
        "required": [
          "provider_request_id", "provider_returned_model_id", "retry_count",
          "http_status", "postprocess_metrics", "extractor_prompt_sha256"
        ],
        "properties": {
          "extractor_provider": {"const": "deepseek"}
        }
      }
    },
    {
      "if": {
        "properties": {"attempt_schema_version": {"const": "claim_extraction_attempt_v1"}}
      },
      "then": {
        "properties": {
          "extractor_provider": {"const": "amazon_bedrock"}
        }
      }
    }
  ]
}
