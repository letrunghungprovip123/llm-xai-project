{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"report_number_v1",
  "type":"object",
  "required":["report_number_id","family","dataset_scope","metric_id","value","population_id","denominator","unit","analysis_lane","source_artifact_id","source_sha256","source_field","source_filter","aggregation"],
  "properties":{
    "report_number_id":{"type":"string","minLength":1},
    "family":{"type":"string","minLength":1},
    "dataset_scope":{"type":"string","enum":["HOME_CREDIT","FREDDIE","CROSS_DATASET","GLOBAL"]},
    "metric_id":{"type":"string","minLength":1},
    "value":{},
    "population_id":{"type":"string","minLength":1},
    "denominator":{"type":["integer","number","null"]},
    "unit":{"type":"string","minLength":1},
    "analysis_lane":{"type":"string","enum":["PRIMARY","SECONDARY","SENSITIVITY","DIAGNOSTIC","DECISION","REPLICATION","LIMITATION"]},
    "source_artifact_id":{"type":"string","minLength":1},
    "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_field":{"type":"string","minLength":1},
    "source_filter":{"type":"object"},
    "aggregation":{"type":"string","enum":["DIRECT_SINGLE_ROW","COUNT_ROWS","SUM","MEAN"]}
  },
  "additionalProperties":true
}
