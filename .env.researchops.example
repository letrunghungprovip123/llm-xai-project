# Server-only FastAPI control-plane target used by the Next.js BFF.
RESEARCHOPS_FASTAPI_BASE_URL=http://127.0.0.1:8000
RESEARCHOPS_BFF_TIMEOUT_MS=30000

# Optional server-side bearer token for JWT-mode deployments.
# Do not expose this with NEXT_PUBLIC_. In local auth mode leave it unset.
# RESEARCHOPS_API_BEARER_TOKEN=

# Browser-visible link to the separately served certified Dash v3 analytical surface.
NEXT_PUBLIC_RESEARCH_DASHBOARD_URL=http://127.0.0.1:8051
