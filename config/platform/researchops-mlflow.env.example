# MLflow 3.14 local ResearchOps service
MLFLOW_VERSION=3.14.0
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_INTERNAL_TRACKING_URI=http://researchops-mlflow:5000

# Dedicated database and role in the existing ResearchOps PostgreSQL server
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_POSTGRES_USER=mlflow_app
MLFLOW_POSTGRES_PASSWORD=change-me-local-only
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://mlflow_app:change-me-local-only@researchops-postgres:5432/mlflow

# Dedicated bucket and scoped MinIO user
MLFLOW_S3_BUCKET=llm-xai-mlflow
MLFLOW_S3_ACCESS_KEY=mlflow-app
MLFLOW_S3_SECRET_KEY=change-me-local-only
MLFLOW_S3_ENDPOINT_URL=http://researchops-minio:9000
MLFLOW_ARTIFACTS_DESTINATION=s3://llm-xai-mlflow/mlartifacts
AWS_DEFAULT_REGION=us-east-1

# MLflow 3.5+ host-header protection
MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,researchops-mlflow:*
