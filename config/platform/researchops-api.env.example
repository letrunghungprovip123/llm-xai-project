# ResearchOps FastAPI control plane
RESEARCHOPS_API_ENVIRONMENT=local
RESEARCHOPS_API_AUTH_MODE=local
RESEARCHOPS_API_LOCAL_SUBJECT=local-developer
RESEARCHOPS_API_LOCAL_ROLES=viewer,operator,reviewer,approver,release-manager,admin
# Replace in shared environments; minimum 32 characters in JWT mode.
RESEARCHOPS_API_CURSOR_SECRET=replace-with-at-least-32-random-characters
RESEARCHOPS_API_DOCS_ENABLED=true
RESEARCHOPS_API_DEFAULT_PAGE_SIZE=50
RESEARCHOPS_API_MAX_PAGE_SIZE=200
RESEARCHOPS_API_DEPENDENCY_TIMEOUT_SECONDS=2.0
RESEARCHOPS_API_CRITICAL_DEPENDENCY_TIMEOUT_SECONDS=3.0

# JWT/OIDC shared-mode settings
# RESEARCHOPS_API_AUTH_MODE=jwt
# RESEARCHOPS_API_JWT_ISSUER=https://issuer.example/
# RESEARCHOPS_API_JWT_AUDIENCE=researchops-api
# RESEARCHOPS_API_JWT_JWKS_URL=https://issuer.example/.well-known/jwks.json
# RESEARCHOPS_API_JWT_ROLES_CLAIM=roles
