{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/prefect_deployments_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "work_pool_name", "source_directory", "deployments"],
  "properties": {
    "schema_version": {"const": "prefect_deployments_v1"},
    "status": {"const": "ACTIVE"},
    "work_pool_name": {"type": "string", "minLength": 1},
    "source_directory": {"type": "string", "pattern": "^/"},
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "flow_name", "deployment_name", "entrypoint", "work_queue_name", "manual_only"],
        "properties": {
          "flow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "flow_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "deployment_name": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "string", "pattern": "^(?:[^:]+:[A-Za-z_][A-Za-z0-9_]*|(?:[A-Za-z_][A-Za-z0-9_]*\\.)+[A-Za-z_][A-Za-z0-9_]*)$"},
          "work_queue_name": {"enum": ["release", "provider-llm", "cpu-heavy", "verification"]},
          "manual_only": {"const": true}
        }
      }
    }
  }
}
