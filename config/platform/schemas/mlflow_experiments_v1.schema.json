{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlflow_experiments_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "experiments", "default_tags"],
  "properties": {
    "schema_version": {"const": "mlflow_experiments_v1"},
    "status": {"const": "ACTIVE"},
    "experiments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "purpose"], "properties": {"name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}}}},
    "default_tags": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
