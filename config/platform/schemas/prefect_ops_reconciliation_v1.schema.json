{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/researchops/prefect_ops_reconciliation_v1.schema.json",
  "title": "Prefect Ops Reconciliation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mode", "passed", "checked_pipeline_runs",
    "checked_stage_runs", "checked_flow_runs", "checked_task_runs",
    "issue_count", "error_count", "warning_count", "repaired_count", "issues"
  ],
  "properties": {
    "schema_version": {"const": "prefect_ops_reconciliation_v1"},
    "mode": {"enum": ["report-only", "repair-safe"]},
    "passed": {"type": "boolean"},
    "checked_pipeline_runs": {"type": "integer", "minimum": 0},
    "checked_stage_runs": {"type": "integer", "minimum": 0},
    "checked_flow_runs": {"type": "integer", "minimum": 0},
    "checked_task_runs": {"type": "integer", "minimum": 0},
    "issue_count": {"type": "integer", "minimum": 0},
    "error_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "repaired_count": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code", "severity", "message", "pipeline_run_id", "stage_run_id",
          "prefect_flow_run_id", "prefect_task_run_id", "approval_id",
          "repairable", "repaired"
        ],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
          "message": {"type": "string", "minLength": 1},
          "pipeline_run_id": {"type": ["string", "null"]},
          "stage_run_id": {"type": ["string", "null"]},
          "prefect_flow_run_id": {"type": ["string", "null"]},
          "prefect_task_run_id": {"type": ["string", "null"]},
          "approval_id": {"type": ["string", "null"]},
          "repairable": {"type": "boolean"},
          "repaired": {"type": "boolean"}
        }
      }
    }
  }
}
