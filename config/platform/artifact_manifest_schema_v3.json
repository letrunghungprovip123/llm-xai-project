{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_manifest_schema_v3",
  "title": "ResearchOps Artifact Manifest V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "artifact_id", "artifact_type", "schema_version", "status",
    "producer", "source", "parents", "files", "limitations", "metadata"
  ],
  "properties": {
    "schema_name": {"const": "artifact_manifest_v3"},
    "artifact_id": {"type": "string", "pattern": "^artifact_[a-z][a-z0-9_]*_[0-9A-HJKMNP-TV-Z]{26}$"},
    "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "schema_version": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "status": {"enum": ["DRAFT", "UPLOADED", "VERIFIED", "CERTIFIED", "REJECTED", "SUPERSEDED"]},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_id", "stage_version", "stage_run_id", "registry_sha256"],
      "properties": {
        "stage_id": {"type": "string"},
        "stage_version": {"type": "integer", "minimum": 1},
        "stage_run_id": {"type": ["string", "null"]},
        "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "environment_snapshot_id", "created_at"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "environment_snapshot_id": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "manifest_sha256", "relationship"],
        "properties": {
          "artifact_id": {"type": "string"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "relationship": {"type": "string", "minLength": 1}
        }
      }
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relative_path", "sha256", "size_bytes", "media_type", "row_count", "column_count"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "row_count": {"type": ["integer", "null"], "minimum": 0},
          "column_count": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
