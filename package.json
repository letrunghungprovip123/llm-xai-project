{
  "name": "llm-xai-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "research": "npm run research:ts",
    "typecheck:research": "npm run typecheck:research:ts",
    "coverage:claim-validation": "node --import tsx research/ts/claim_validation/testing/coverageRunner.ts",
    "mutation:claim-validation": "node --import tsx research/ts/claim_validation/testing/mutationRunner.ts",
    "regression:claim-validation": "node --import tsx research/ts/claim_validation/testing/regressionRunner.ts",
    "determinism:claim-validation": "node --import tsx research/ts/claim_validation/testing/determinismComparator.ts",
    "test:research": "npm run test:research:ts",
    "research:ts": "tsx research/ts/cli.ts",
    "typecheck:research:ts": "tsc -p tsconfig.research.json --noEmit",
    "test:research:ts": "node --import tsx --test tests/llmValidation/*.test.ts tests/research/ts/*.test.ts tests/research/ts/narrative/*.test.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1079.0",
    "@aws-sdk/client-s3": "^3.1084.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.102.2",
    "antd": "^6.4.4",
    "axios": "^1.18.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
